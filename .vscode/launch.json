{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Voxalibera",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/voxalibera_artefacts/Release/voxalibera",
			"cwd": "${workspaceFolder}",
			"MIMode": "gdb",
			"preLaunchTask": "Build"
		},
		{
			"name": "Debug Voxalibera (sanitizers)",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build-debug/voxalibera_artefacts/Debug/voxalibera",
			"cwd": "${workspaceFolder}",
			"environment": [{ "name": "ASAN_OPTIONS", "value": "detect_leaks=0" }],
			"MIMode": "gdb",
			"setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
			"preLaunchTask": "Build debug"
		}
	]
}
